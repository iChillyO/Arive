<Window x:Class="StackByAivre.Client.Views.MainWindow.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auth="clr-namespace:StackByAivre.Client.Views.Auth"
        xmlns:workspace="clr-namespace:StackByAivre.Client.Views.Workspace"
        Title="Stack by Aivre"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border CornerRadius="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- Custom Title Bar -->
            <Border Height="36" VerticalAlignment="Top" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseLeftButtonUp="TitleBar_MouseUp">
                <Grid>
                    <!-- macOS-style window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FF5F57" Margin="0,0,8,0" Cursor="Hand"
                                 MouseLeftButtonDown="CloseButton_Click" />
                        <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,8,0" Cursor="Hand"
                                 MouseLeftButtonDown="MinimizeButton_Click" />
                        <Ellipse Width="12" Height="12" Fill="#28CA42" Cursor="Hand"
                                 MouseLeftButtonDown="MaximizeButton_Click" />
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock Text="Stack by Aivre"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleBrush}"
                               FontSize="12" FontWeight="Medium" />
                </Grid>
            </Border>

            <!-- Main Content Area (swapped by NavigationService) -->
            <ContentControl x:Name="MainContent" Margin="0,36,0,0" />
        </Grid>
    </Border>
</Window>
