<UserControl x:Class="StackByAivre.Client.Views.Workspace.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="32">
        <StackPanel Margin="32">
            <!-- Welcome -->
            <TextBlock Text="Good evening" Foreground="{DynamicResource ForegroundBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="What would you like to work on today?" Foreground="{DynamicResource SubtleBrush}" FontSize="14" Margin="0,0,0,32" />

            <!-- Quick Actions -->
            <TextBlock Text="Quick Actions" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,12" />
            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,32">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,12" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1A3B82F6" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Start Chat" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,12" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1A10B981" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Write Code" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1AA855F7" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Generate Image" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1AF59E0B" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Take Notes" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1A06B6D4" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Market Data" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1AF43F5E" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Voice Call" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent Conversations -->
            <TextBlock Text="Recent Conversations" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,12" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource SidebarActiveBrush}" Margin="0,0,0,8" Cursor="Hand">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="React component architecture" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" />
                                <TextBlock Text="AI Coder" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="2h ago" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource SidebarActiveBrush}" Margin="0,0,0,8" Cursor="Hand">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Market analysis for Q2" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" />
                                <TextBlock Text="Research Agent" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="5h ago" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource SidebarActiveBrush}" Cursor="Hand">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Landing page redesign ideas" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" />
                                <TextBlock Text="AI Chat" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="1d ago" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
