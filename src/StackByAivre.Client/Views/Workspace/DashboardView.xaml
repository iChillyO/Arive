<UserControl x:Class="StackByAivre.Client.Views.Workspace.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="40,24,40,40">

            <!-- Header: Greeting + Battery + Search -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Greeting -->
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="GreetingText" Text="Good evening,"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="Stack by Aivre"
                               Foreground="{DynamicResource SubtleBrush}"
                               FontSize="13" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Battery indicator -->
                <Border Grid.Column="1" CornerRadius="14" Background="{DynamicResource CardBrush}"
                        Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BatteryText" Text="49%"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Column="2" CornerRadius="14" Background="{DynamicResource CardBrush}"
                        Padding="14,8" VerticalAlignment="Center" Width="240">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                 VerticalAlignment="Center"
                                 Tag="Search tools..." />
                    </Grid>
                </Border>
            </Grid>

            <!-- Top Widget Row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <!-- Clock widget -->
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="20"
                        Background="{DynamicResource CardBrush}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="ClockDate" Text="Sun, Apr 12"
                                   Foreground="{DynamicResource SubtleBrush}" FontSize="13" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="ClockTime" Text="1:08"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="44" FontWeight="Bold" />
                            <TextBlock x:Name="ClockSeconds" Text="48"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="16" FontWeight="Medium"
                                       VerticalAlignment="Top" Margin="6,8,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ClockAmPm" Text="AM"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,6" />

                        <!-- Date strip -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border CornerRadius="14" Background="{DynamicResource ForegroundBrush}" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="12" Foreground="{DynamicResource BackgroundBrush}" FontSize="11" FontWeight="Medium" />
                            </Border>
                            <TextBlock Text="13" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                            <TextBlock Text="14" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                            <TextBlock Text="15" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                            <TextBlock Text="16" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                            <TextBlock Text="17" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                            <TextBlock Text="18" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,4,6,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stopwatch / Timer widget -->
                <Border Grid.Column="1" Margin="8,0" CornerRadius="20"
                        Background="{DynamicResource CardBrush}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tabs -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border CornerRadius="14" Background="{DynamicResource ForegroundBrush}" Padding="12,4" Margin="0,0,4,0">
                                <TextBlock Text="Stopwatch" Foreground="{DynamicResource BackgroundBrush}" FontSize="11" FontWeight="Medium" />
                            </Border>
                            <Border CornerRadius="14" Background="Transparent" Padding="12,4">
                                <TextBlock Text="Timer" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                            </Border>
                        </StackPanel>

                        <!-- Time display -->
                        <TextBlock Grid.Row="1" x:Name="StopwatchDisplay" Text="00:00:00"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="32" FontWeight="Bold"
                                   FontFamily="Cascadia Mono, Consolas"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <!-- Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="StopwatchStart" Padding="14,7" Margin="0,0,8,0" Cursor="Hand"
                                    Background="{DynamicResource SidebarActiveBrush}" BorderThickness="0"
                                    Click="StopwatchStart_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Start" Foreground="{DynamicResource ForegroundBrush}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopwatchReset" Padding="14,7" Cursor="Hand"
                                    Background="{DynamicResource SidebarActiveBrush}" BorderThickness="0"
                                    Click="StopwatchReset_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Reset" Foreground="{DynamicResource ForegroundBrush}" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Weather widget -->
                <Border Grid.Column="2" Margin="8,0" CornerRadius="20"
                        Background="{DynamicResource CardBrush}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Weather" Foreground="{DynamicResource SubtleBrush}" FontSize="13" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="34" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="17" FontSize="44" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="&#xB0;" FontSize="34" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Clear sky" Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
                    </Grid>
                </Border>

                <!-- Featured Banner widget (Aivre Expo) -->
                <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="20" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1E1E" Offset="0" />
                            <GradientStop Color="#2A1810" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Decorative gradient overlay -->
                        <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-100,-100" Opacity="0.6">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF7A00" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Logo dot -->
                            <Border Grid.Row="0" Width="20" Height="20" CornerRadius="5"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0" />
                                        <GradientStop Color="#EC4899" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Big title -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="AIVRE" Foreground="White" FontSize="28" FontWeight="Black" LineHeight="28" />
                                <TextBlock Text="EXPO" Foreground="White" FontSize="28" FontWeight="Black" LineHeight="28" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Shaping the future"
                                       Foreground="#D4D4D4" FontSize="11" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Calendar widget -->
            <Border CornerRadius="20" Background="{DynamicResource CardBrush}" Padding="20" Margin="0,0,0,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="CalendarMonth" Text="April 2026"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="16" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Padding="6" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Width="24" Height="24">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </Button>
                            <Button Padding="6" Margin="4,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Width="24" Height="24">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Day headers -->
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="M" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="T" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="W" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="T" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="F" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="S" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="S" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Center" />
                    </UniformGrid>

                    <!-- Calendar grid (built in code-behind) -->
                    <UniformGrid Grid.Row="2" x:Name="CalendarDays" Columns="7" Rows="6" />
                </Grid>
            </Border>

            <!-- AI Agents header -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="AI Agents" Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="15" FontWeight="Bold" />
                <TextBlock Text="16 tools" Foreground="{DynamicResource SubtleBrush}"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Category filter pills -->
            <ItemsControl Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Border CornerRadius="14" Background="{DynamicResource ForegroundBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="All" Foreground="{DynamicResource BackgroundBrush}" FontSize="11" FontWeight="Medium" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Assistant" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Developer" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Knowledge" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Creative" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Productivity" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Business" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Language" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Education" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource SidebarActiveBrush}" Padding="14,6" Margin="0,0,6,6" Cursor="Hand">
                    <TextBlock Text="Professional" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </Border>
            </ItemsControl>

            <!-- AI Agents grid -->
            <UniformGrid Columns="8" Rows="2">
                <!-- Row 1 -->
                <Border CornerRadius="18" Background="#1E40AF" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#1A1A1A" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A3A3A3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#7C2D12" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#065F46" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#3F3F00" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#1E3A5F" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#581C87" Margin="0,0,8,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#831843" Margin="0,0,0,8" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Row 2 -->
                <Border CornerRadius="18" Background="#7C2D12" Margin="0,0,8,0" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#064E3B" Margin="0,0,8,0" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#3F3F00" Margin="0,0,8,0" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#7F1D1D" Margin="0,0,8,0" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="18" Background="#1A1A1A" Margin="0,0,8,0" Cursor="Hand" Width="80" Height="80">
                    <TextBlock Text="&#xF1AD;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A3A3A3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </UniformGrid>

            <!-- Agent labels -->
            <UniformGrid Columns="8" Rows="2" Margin="0,8,0,0">
                <TextBlock Text="Chat" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Coder" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Research" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Writer" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Notes" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Analyst" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Strategist" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Designer" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Translator" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Tutor" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Legal" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Math" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
