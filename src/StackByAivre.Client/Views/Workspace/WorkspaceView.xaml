<UserControl x:Class="StackByAivre.Client.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Minimal Icon Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,28">
                    <TextBlock Text="&#x25C6;" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Aivre" FontSize="9" Foreground="{DynamicResource SubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Top Navigation -->
                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                    <RadioButton x:Name="NavDashboard" GroupName="MainNav" IsChecked="True"
                                 Checked="Nav_Checked" Tag="Dashboard"
                                 Style="{StaticResource SidebarIconButton}">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </RadioButton>
                    <RadioButton GroupName="MainNav" Checked="Nav_Checked" Tag="Settings"
                                 Style="{StaticResource SidebarIconButton}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Section -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <!-- Theme toggle -->
                    <Button x:Name="ThemeToggleButton" Width="40" Height="40" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
                            Click="ThemeToggle_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Button>

                    <!-- Profile -->
                    <Button Width="40" Height="40" Cursor="Hand"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with floating voice widget -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="WorkspaceContent" />

            <!-- Floating Voice Call Widget -->
            <Border x:Name="VoiceCallWidget" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="20,0,0,20" CornerRadius="20"
                    Background="{DynamicResource CardBrush}" Padding="6"
                    Effect="{x:Null}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pulsing indicator -->
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="10,0,10,0" VerticalAlignment="Center" />

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Stack Chat - Voice"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="11" FontWeight="Medium" />
                        <TextBlock x:Name="VoiceCallDuration" Text="00:00"
                                   Foreground="{DynamicResource SubtleBrush}" FontSize="10" />
                    </StackPanel>

                    <!-- Mic button -->
                    <Button Width="32" Height="32" Cursor="Hand" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </Button>

                    <!-- End button -->
                    <Button Cursor="Hand" Padding="10,6" Margin="0,0,4,0" Click="EndVoiceCall_Click"
                            Background="#DC2626" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF405;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="End" Foreground="White" FontSize="10" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
