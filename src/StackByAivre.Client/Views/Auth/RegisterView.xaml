<UserControl x:Class="StackByAivre.Client.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <!-- Background glow -->
        <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColorValue}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Register Card -->
        <Border Style="{StaticResource GlassPanel}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Stack" Foreground="{DynamicResource ForegroundBrush}" FontSize="22"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Create Account" Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Join the next generation of AI workspaces" Foreground="{DynamicResource SubtleBrush}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Username / Display Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Username" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="UsernameInput" Style="{StaticResource GlassInput}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Display Name" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="DisplayNameInput" Style="{StaticResource GlassInput}" />
                    </StackPanel>
                </Grid>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="EmailInput" Style="{StaticResource GlassInput}" Margin="0,0,0,12" />

                <!-- Password -->
                <TextBlock Text="Password" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                             Padding="12,10" FontSize="13" />

                <!-- Gender / Birthdate -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gender" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="GenderInput" Background="{DynamicResource InputBrush}" FontSize="13">
                            <ComboBoxItem Content="Male" />
                            <ComboBoxItem Content="Female" />
                            <ComboBoxItem Content="Other" />
                            <ComboBoxItem Content="Prefer not to say" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Birthdate" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker x:Name="BirthdateInput" Background="{DynamicResource InputBrush}" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Foreground="#F43F5E" FontSize="12" Margin="0,0,0,12"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Register Button -->
                <Button x:Name="RegisterButton" Style="{StaticResource AccentButton}" Content="Create Account"
                        HorizontalAlignment="Stretch" Click="RegisterButton_Click" />

                <!-- Login link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Already have an account? " Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
                    <TextBlock Text="Sign in" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                               Cursor="Hand" MouseLeftButtonDown="LoginLink_Click" TextDecorations="Underline" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
