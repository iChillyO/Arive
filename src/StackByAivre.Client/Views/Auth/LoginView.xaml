<UserControl x:Class="StackByAivre.Client.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <!-- Background glow -->
        <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColorValue}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Login Card -->
        <Border Style="{StaticResource GlassPanel}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Stack" Foreground="{DynamicResource ForegroundBrush}" FontSize="22"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Welcome Back" Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Sign in to your workspace" Foreground="{DynamicResource SubtleBrush}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Google Sign In -->
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                        BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="G" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Continue with Google" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Divider -->
                <Grid Margin="0,12,0,16">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="or" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource SubtleBrush}"
                               FontSize="11" Padding="12,0" HorizontalAlignment="Center" />
                </Grid>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="EmailInput" Style="{StaticResource GlassInput}" Margin="0,0,0,12" />

                <!-- Password -->
                <TextBlock Text="Password" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,20"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                             Padding="12,10" FontSize="13" />

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Foreground="#F43F5E" FontSize="12" Margin="0,0,0,12"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Sign In -->
                <Button x:Name="LoginButton" Style="{StaticResource AccentButton}" Content="Sign In"
                        HorizontalAlignment="Stretch" Click="LoginButton_Click" />

                <!-- Register link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="No account? " Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
                    <TextBlock x:Name="RegisterLink" Text="Create one" Foreground="{DynamicResource AccentBrush}"
                               FontSize="12" Cursor="Hand" MouseLeftButtonDown="RegisterLink_Click"
                               TextDecorations="Underline" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
