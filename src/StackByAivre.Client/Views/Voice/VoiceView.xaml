<UserControl x:Class="StackByAivre.Client.Views.Voice.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Voice orb -->
            <Border x:Name="VoiceOrb" Width="120" Height="120" CornerRadius="60"
                    Background="{DynamicResource AccentBrush}" Opacity="0.6"
                    HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Status -->
            <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock x:Name="DurationLabel" Text="00:00" Foreground="{DynamicResource SubtleBrush}"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,32" />

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="MuteButton" Style="{StaticResource GhostButton}" Width="44" Height="44"
                        Padding="12" Margin="0,0,8,0" Click="MuteButton_Click">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button x:Name="CallButton" Style="{StaticResource AccentButton}" Padding="20,12" Click="CallButton_Click">
                    <TextBlock x:Name="CallButtonText" Text="Begin Call" FontSize="13" />
                </Button>
                <Button x:Name="SpeakerButton" Style="{StaticResource GhostButton}" Width="44" Height="44"
                        Padding="12" Margin="8,0,0,0" Click="SpeakerButton_Click">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
