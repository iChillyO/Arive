<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Refined light palette -->
    <Color x:Key="BackgroundColor">#F4F4F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E4E4E7</Color>
    <Color x:Key="ForegroundColor">#09090B</Color>
    <Color x:Key="MutedColor">#52525B</Color>
    <Color x:Key="SubtleColor">#A1A1AA</Color>
    <Color x:Key="TertiaryColor">#D4D4D8</Color>
    <Color x:Key="AccentColorValue">#6366F1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#336366F1" />

    <!-- Glass surfaces -->
    <SolidColorBrush x:Key="GlassBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#CCF4F4F5" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource MutedColor}" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#E4E4E7" />

    <!-- Input -->
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource AccentColorValue}" />

</ResourceDictionary>
