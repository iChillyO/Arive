<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Refined dark palette with subtle blue undertones -->
    <Color x:Key="BackgroundColor">#08090A</Color>
    <Color x:Key="SurfaceColor">#0F1011</Color>
    <Color x:Key="CardColor">#141618</Color>
    <Color x:Key="BorderColor">#1F2123</Color>
    <Color x:Key="ForegroundColor">#FAFAFA</Color>
    <Color x:Key="MutedColor">#9CA3AF</Color>
    <Color x:Key="SubtleColor">#6B7280</Color>
    <Color x:Key="TertiaryColor">#3F4348</Color>
    <Color x:Key="AccentColorValue">#6366F1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4D6366F1" />

    <!-- Glass surfaces -->
    <SolidColorBrush x:Key="GlassBrush" Color="#99141618" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#CC1F2123" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource MutedColor}" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A0B0C" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#1F2123" />

    <!-- Input -->
    <SolidColorBrush x:Key="InputBrush" Color="#0F1011" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1F2123" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource AccentColorValue}" />

</ResourceDictionary>
