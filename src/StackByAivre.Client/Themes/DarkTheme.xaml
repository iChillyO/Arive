<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Colors -->
    <Color x:Key="BackgroundColor">#0A0A0A</Color>
    <Color x:Key="SurfaceColor">#141414</Color>
    <Color x:Key="CardColor">#1A1A1A</Color>
    <Color x:Key="BorderColor">#2A2A2A</Color>
    <Color x:Key="ForegroundColor">#FAFAFA</Color>
    <Color x:Key="MutedColor">#A3A3A3</Color>
    <Color x:Key="SubtleColor">#737373</Color>
    <Color x:Key="AccentColorValue">#6366F1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4D6366F1" />

    <!-- Glass -->
    <SolidColorBrush x:Key="GlassBrush" Color="#99141414" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#CC1E1E1E" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#525252" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#1A1A1A" />

    <!-- Input -->
    <SolidColorBrush x:Key="InputBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#262626" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource AccentColorValue}" />

</ResourceDictionary>
